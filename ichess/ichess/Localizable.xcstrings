    "Not sure? Start with Beginner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定选哪档？可以先选入门。"
          }
        }
      }
    },
    "Choose before your first move to apply immediately. Changes during a game apply next game. Difficulty does not change your practice points.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开局前选择立即生效；对局中修改从下一盘生效。难度不会改变你的练习积分。"
          }
        }
      }
    },
    "Choose Difficulty": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择难度"
          }
