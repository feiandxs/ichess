            "state": "translated",
            "value": "你在 %lld 步内有强制杀棋，找找看！"
          }
        }
      }
    },
    "Your opponent’s %@ on %@ is giving check. Capture it, block it, or move your king.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方 %2$@ 的%1$@正在将军。吃掉它、挡住它，或者移开你的王。"
          }
        }
      }
    },
    "Your opponent’s %@ on %@ has no defender. Can you capture it?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方 %2$@ 的%1$@没人保护，看看能不能吃。"
          }
        }
      }
    },
    "Your opponent’s %@ on %@ attacks your undefended %@ on %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的%1$@在 %2$@，正在攻击你 %4$@ 的%3$@，且没人保护。"
          }
        }
      }
    },
    "Your %@ on %@ attacks your opponent’s more valuable %@ on %@. Can you win it?": {
