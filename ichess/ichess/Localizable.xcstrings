    "Choose before your first move to apply immediately. Changes during a game apply next game. Difficulty does not change the points you earn in Battle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始第一步之前选择会立即生效，对局中更改则从下一局开始。难度不会影响你在对战中获得的积分。"
          }
        }
      }
    },
